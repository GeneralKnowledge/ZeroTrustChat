{
  "name": "zerotrustchat",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first P2P chat prototype — devices own data; server is signalling only",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter='./packages/*' --filter='./apps/*'",
    "test:e2e": "pnpm --filter @ztc/e2e test:e2e",
    "test:privacy": "pnpm --filter @ztc/privacy-tests test",
    "boundary-scan": "pnpm --filter @ztc/e2e test:privacy-scan",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
